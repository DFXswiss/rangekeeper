# CoinGecko origin for the BTC reference price on the dashboard. In the
# cluster, leave the default — the in-cluster pricing-proxy holds the
# upstream key and shares the 60 s cache + monthly quota monitor. Override
# with `https://api.coingecko.com` for local dev or to bypass the proxy.
COINGECKO_BASE_URL=http://pricing-proxy:8080/coingecko
